# Database
DB_USER=ascend
DB_PASSWORD=changeme
DB_NAME=ascend_db

# pgAdmin (dev)
PGADMIN_EMAIL=admin@ascend.dev
PGADMIN_PASSWORD=changeme

# Auth
JWT_SECRET=CHANGE_ME_generate_a_random_64_byte_hex_string
INTERNAL_TOKEN=CHANGE_ME_generate_a_random_token

# Google OAuth
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=

# RabbitMQ
RABBITMQ_USER=ascend
RABBITMQ_PASSWORD=changeme
RABBITMQ_URL=amqp://ascend:changeme@rabbitmq:5672/ascend_vhost

# MinIO
MINIO_ROOT_USER=ascend
MINIO_ROOT_PASSWORD=changeme_min_8_chars
MINIO_ACCESS_KEY=CHANGE_ME_generate_access_key
MINIO_SECRET_KEY=CHANGE_ME_generate_secret_key

# Gateway
GATEWAY_ENDPOINT=http://gateway:8080

# Admin seed account
ASCEND_ADMIN_FIRST_NAME=Ascend
ASCEND_ADMIN_LAST_NAME=System
ASCEND_ADMIN_EMAIL=admin@ascend.dev
ASCEND_ADMIN_PASSWORD=changeme

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET_KEY=whsec_...
PAYMENT_BASE_URL=http://localhost:3014
FRONTEND_BASE_URL=http://localhost:3000
SESSION_TOKEN_EXPIRY_MS=3600000
SESSION_TOKEN_EXPIRY_CHECK_INTERVAL_MS=60000

# Firebase
FIREBASE_SERVICE_ACCOUNT=
